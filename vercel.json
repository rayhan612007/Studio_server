{
    "version": 2,
    "builds": [
        {
            "src": "index.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "source": "/(.*)",
            "destination": "index.js"
        }
    ],
    "crons": [
        {
            "path": "/cron/bookings",
            "schedule": "*/5 * * * *"
        }
    ]
}